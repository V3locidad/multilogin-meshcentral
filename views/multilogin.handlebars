<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Multi-Login KVM</title>
<style>
  body { font-family: sans-serif; padding: 12px; }
  h2 { margin-top: 0; }
  .row { margin-bottom: 10px; }
  .row label { margin-right: 12px; }
  .panes { display: flex; gap: 12px; margin: 10px 0; }
  #ml_groups { flex: 0 0 280px; max-height: 380px; overflow: auto; border: 1px solid #ccc; padding: 8px; background: #f8f8f8; }
  #ml_nodes { flex: 1; max-height: 380px; overflow: auto; border: 1px solid #ccc; padding: 8px; }
  #ml_groups div, #ml_nodes div { padding: 2px 0; }
  #ml_groups .pane-title, #ml_nodes .pane-title { font-weight: bold; margin-bottom: 6px; border-bottom: 1px solid #ccc; padding-bottom: 4px; }
  #ml_log { background: #111; color: #0f0; padding: 8px; height: 240px; overflow: auto; font-size: 12px; white-space: pre-wrap; }
  button { padding: 8px 16px; font-size: 14px; cursor: pointer; }
  .toolbar { margin: 10px 0; }
  input[type=text], input[type=password] { padding: 4px 6px; }
  .search { width: 100%; padding: 4px 6px; margin-bottom: 6px; box-sizing: border-box; }
</style>
</head>
<body>

<h2>Connexion multiple (KVM)</h2>

<div class="row">
  <label>Compte enregistre :
    <select id="ml_accounts" onchange="loadAccount()">
      <option value="">-- saisie manuelle --</option>
    </select>
  </label>
  <button onclick="saveAccount()" style="padding:4px 10px;font-size:13px">Enregistrer</button>
  <button onclick="deleteAccount()" style="padding:4px 10px;font-size:13px">Supprimer</button>
</div>

<div class="row">
  <label>Login : <input id="ml_user" type="text" autocomplete="off"></label>
  <label>Mot de passe : <input id="ml_pass" type="password" autocomplete="new-password"></label>
</div>

<div class="toolbar">
  <button onclick="selectAll(true)">Tout cocher</button>
  <button onclick="selectWindowsOnly()">Cocher Windows uniquement</button>
  <button onclick="selectAll(false)">Tout decocher</button>
  <span id="ml_count" style="margin-left:10px;color:#666"></span>
</div>

<div class="panes">
  <div id="ml_groups">
    <div class="pane-title">Groupes</div>
    <input type="text" id="ml_search_groups" class="search" placeholder="Filtrer les groupes..." oninput="filterGroups()">
    <div id="ml_groups_list">Chargement...</div>
  </div>
  <div id="ml_nodes">
    <div class="pane-title">Postes</div>
    <input type="text" id="ml_search_nodes" class="search" placeholder="Filtrer les postes..." oninput="filterNodes()">
    <div id="ml_nodes_list">Chargement...</div>
  </div>
</div>

<div class="toolbar">
  <button onclick="runMultiLogin()">Lancer la connexion sur les postes coches</button>
  <span id="ml_status" style="margin-left:12px;color:#444;font-weight:bold"></span>
  <button onclick="toggleLogs()" style="float:right;font-size:12px;padding:4px 8px">Logs</button>
</div>

<pre id="ml_log" style="display:none"></pre>

<script>
// ====================================================================
// Multi-Login KVM - utilise les fonctions internes MeshCentral :
//   CreateAgentRedirect + CreateAgentRemoteDesktop
// Elles gerent automatiquement : tunnel, auth, handshake, protocole KVM
// ====================================================================

const MAX_PARALLEL = 1;  // sequentiel : cookie a usage unique, eviter les races
const sleep = (ms) => new Promise(r => setTimeout(r, ms));

// Demande un authCookie FRAIS au serveur et attend qu'il soit propage
async function refreshAuthCookie(ctx, log) {
  const oldCookie = ctx.authCookie;
  try { ctx.meshserver.send({ action: 'authcookie' }); } catch (e) {
    if (log) log('refreshAuthCookie : ms.send erreur ' + e.message);
    return null;
  }
  // Attendre jusqu'a 3s que ctx.authCookie change
  for (let i = 0; i < 30; i++) {
    await sleep(100);
    if (ctx.authCookie && ctx.authCookie !== oldCookie && ctx.authCookie.length > 10) {
      return ctx.authCookie;
    }
  }
  // Si pas de changement, retourne ce qu'on a quand meme
  return ctx.authCookie || null;
}

// Scancodes XT
const SC_TAB = 0x0F;
const SC_ENTER = 0x1C;

// Recupere les symboles MeshCentral depuis parent/top
function getMeshCentralAPI() {
  const ctxs = [];
  try { ctxs.push(parent); } catch (e) {}
  try { ctxs.push(parent.parent); } catch (e) {}
  try { ctxs.push(top); } catch (e) {}

  for (const ctx of ctxs) {
    try {
      if (ctx && ctx.meshserver && ctx.CreateAgentRedirect && ctx.CreateAgentRemoteDesktop) {
        return {
          ctx: ctx,
          meshserver: ctx.meshserver,
          CreateAgentRedirect: ctx.CreateAgentRedirect,
          CreateAgentRemoteDesktop: ctx.CreateAgentRemoteDesktop,
          authCookie: ctx.authCookie,
          authRelayCookie: ctx.authRelayCookie,
          serverPublicNamePort: ctx.serverPublicNamePort,
          domainUrl: ctx.domainUrl || ''
        };
      }
    } catch (e) {}
  }
  return null;
}

// Cree un canvas cache dans le document du parent (CreateAgentRemoteDesktop
// utilise document.getElementById() depuis le contexte parent).
function createHiddenCanvas(parentCtx) {
  const id = 'ml_canvas_' + Math.random().toString(36).slice(2, 10);
  const c = parentCtx.document.createElement('canvas');
  c.id = id;
  c.width = 800;
  c.height = 600;
  c.style.cssText = 'position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;visibility:hidden';
  parentCtx.document.body.appendChild(c);
  return { id, element: c };
}

async function loginOnNode(nodeid, login, pass, log) {
  const api = getMeshCentralAPI();
  if (!api) {
    log(`[${nodeid}] ERREUR : API MeshCentral introuvable`);
    return false;
  }

  // Demande un authCookie frais (les anciens sont a usage unique)
  const freshCookie = await refreshAuthCookie(api.ctx, log);
  if (!freshCookie) {
    log(`[${nodeid}] ERREUR : impossible de rafraichir authCookie`);
    return false;
  }
  log(`[${nodeid}] cookie frais (${freshCookie.length} chars)`);

  return new Promise((resolve) => {
    // Canvas cache requis par CreateAgentRemoteDesktop
    let canvas;
    try { canvas = createHiddenCanvas(api.ctx); }
    catch (e) { log(`[${nodeid}] canvas creation : ${e.message}`); return resolve(false); }

    let desktop;
    try {
      desktop = api.CreateAgentRedirect(
        api.meshserver,
        api.CreateAgentRemoteDesktop(canvas.id),
        api.serverPublicNamePort,
        freshCookie,
        api.ctx.authRelayCookie,
        api.domainUrl
      );
    } catch (e) {
      log(`[${nodeid}] CreateAgentRedirect exception : ${e.message}`);
      try { canvas.element.remove(); } catch (e2) {}
      return resolve(false);
    }

    // Setup complet comme MeshCentral le fait dans connectDesktop()
    try {
      desktop.m.UseExtendedKeyFlag = true;
      desktop.attemptWebRTC = false;
      desktop.options = {};
      desktop.m.ImageType = 1;
      desktop.m.CompressionLevel = 50;
      desktop.m.ScalingLevel = 1024;
      desktop.m.FrameRateTimer = 100;
      desktop.m.debugmode = 1;                 // les SendKey* loggent dans la console DevTools
    } catch (e) {
      log(`[${nodeid}] setup desktop.m : ${e.message}`);
    }

    let finished = false;
    const finish = (ok, msg) => {
      if (finished) return;
      finished = true;
      log(`[${nodeid}] ${msg}`);
      try { desktop.Stop(); } catch (e) {}
      try { canvas.element.remove(); } catch (e) {}
      resolve(ok);
    };

    const timer = setTimeout(() => finish(false, 'timeout 35s'), 35000);

    // Lance la connexion immediatement (on poll desktop.m.State plutot que onStateChanged
    // pour etre sur que le module KVM lui-meme est pret avant d'envoyer les touches)
    try {
      desktop.Start(nodeid);
      log(`[${nodeid}] Start() lance`);
    } catch (e) {
      clearTimeout(timer);
      return finish(false, 'Start() exception : ' + e.message);
    }

    (async () => {
      try {
        // Delai fixe : laisser la connexion s'etablir pleinement
        log(`[${nodeid}] delai 5s pour stabiliser la connexion KVM...`);
        await sleep(5000);

        if (desktop.m.State !== 3) {
          clearTimeout(timer);
          return finish(false, `State pas 3 apres 5s (=${desktop.m.State})`);
        }
        log(`[${nodeid}] State=${desktop.m.State}, tilesRecus=${desktop.m.tilesReceived || 0}`);

        log(`[${nodeid}] envoi Ctrl+Alt+Del`);
        desktop.m.SendCtrlAltDelMsg();
        await sleep(4000);

        // Envoi char par char avec delais (plus tolerant que SendStringUnicode)
        log(`[${nodeid}] tape login : "${login}" (${login.length} chars)`);
        for (let i = 0; i < login.length; i++) {
          const cp = login.charCodeAt(i);
          desktop.m.SendKeyUnicode(1, cp);  // down
          await sleep(30);
          desktop.m.SendKeyUnicode(2, cp);  // up
          await sleep(100);
        }
        await sleep(400);

        log(`[${nodeid}] Tab`);
        desktop.m.SendKeyMsgKC(1, SC_TAB);
        await sleep(40);
        desktop.m.SendKeyMsgKC(2, SC_TAB);
        await sleep(500);

        log(`[${nodeid}] tape mot de passe (${pass.length} chars)`);
        for (let i = 0; i < pass.length; i++) {
          const cp = pass.charCodeAt(i);
          desktop.m.SendKeyUnicode(1, cp);
          await sleep(30);
          desktop.m.SendKeyUnicode(2, cp);
          await sleep(100);
        }
        await sleep(400);

        log(`[${nodeid}] Enter`);
        desktop.m.SendKeyMsgKC(1, SC_ENTER);
        await sleep(40);
        desktop.m.SendKeyMsgKC(2, SC_ENTER);
        await sleep(2500);

        clearTimeout(timer);
        finish(true, 'sequence envoyee');
      } catch (e) {
        clearTimeout(timer);
        finish(false, 'erreur envoi : ' + e.message);
      }
    })();
  });
}

// Injecte le worker dans parent.window via un <script> tag.
// Important : l'iframe peut etre refresh par MeshCentral pendant la sequence,
// ce qui tuerait notre JS. En tournant dans parent, on survit a ces refresh.
function injectWorkerOnce() {
  if (parent.__multilogin_worker_ready) return;
  parent.__multilogin_worker_ready = true;

  const script = parent.document.createElement('script');
  script.textContent = `
    (function() {
      var ml = window.__multilogin = window.__multilogin || {};
      ml.sleep = function(ms){ return new Promise(function(r){ setTimeout(r, ms); }); };

      ml.appendLog = function(line) {
        try {
          var prev = localStorage.getItem('multilogin_log') || '';
          localStorage.setItem('multilogin_log', prev + line + '\\n');
        } catch (e) {}
        console.log('[multilogin]', line);
      };
      ml.log = function(m) { ml.appendLog('[' + new Date().toLocaleTimeString() + '] ' + m); };

      ml.refreshAuthCookie = async function() {
        var old = window.authCookie;
        try { meshserver.send({action:'authcookie'}); } catch (e) { return null; }
        for (var i = 0; i < 30; i++) {
          await ml.sleep(100);
          if (window.authCookie && window.authCookie !== old && window.authCookie.length > 10) return window.authCookie;
        }
        return window.authCookie || null;
      };

      ml.createHiddenCanvas = function() {
        var id = 'ml_canvas_' + Math.random().toString(36).slice(2, 10);
        var c = document.createElement('canvas');
        c.id = id; c.width = 800; c.height = 600;
        c.style.cssText = 'position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;visibility:hidden';
        document.body.appendChild(c);
        return c;
      };

      ml.loginOnNode = async function(nodeid, login, pass) {
        ml.log('[' + nodeid + '] demarrage');
        var cookie = await ml.refreshAuthCookie();
        if (!cookie) { ml.log('[' + nodeid + '] ERREUR cookie'); return false; }
        ml.log('[' + nodeid + '] cookie frais (' + cookie.length + ')');

        var canvas = ml.createHiddenCanvas();
        var desktop;
        try {
          desktop = CreateAgentRedirect(meshserver, CreateAgentRemoteDesktop(canvas.id),
            serverPublicNamePort, cookie, authRelayCookie, domainUrl || '');
        } catch (e) {
          ml.log('[' + nodeid + '] CreateAgentRedirect : ' + e.message);
          try { canvas.remove(); } catch (e) {}
          return false;
        }

        try {
          desktop.m.UseExtendedKeyFlag = true;
          desktop.attemptWebRTC = false;
          desktop.options = {};
          desktop.m.ImageType = 1;
          desktop.m.CompressionLevel = 50;
          desktop.m.ScalingLevel = 1024;
          desktop.m.FrameRateTimer = 100;
        } catch (e) {}

        try { desktop.Start(nodeid); } catch (e) {
          ml.log('[' + nodeid + '] Start : ' + e.message);
          try { canvas.remove(); } catch (e) {}
          return false;
        }
        ml.log('[' + nodeid + '] Start() lance, attente connexion');
        await ml.sleep(2500);
        ml.log('[' + nodeid + '] State=' + desktop.m.State + ', envoi CAD');
        desktop.m.SendCtrlAltDelMsg();
        await ml.sleep(2000);

        ml.log('[' + nodeid + '] tape login');
        for (var i = 0; i < login.length; i++) {
          var cp = login.charCodeAt(i);
          desktop.m.SendKeyUnicode(1, cp);
          await ml.sleep(15);
          desktop.m.SendKeyUnicode(2, cp);
          await ml.sleep(50);
        }
        await ml.sleep(200);

        ml.log('[' + nodeid + '] Tab');
        desktop.m.SendKeyMsgKC(1, 9);
        await ml.sleep(30);
        desktop.m.SendKeyMsgKC(2, 9);
        await ml.sleep(300);

        ml.log('[' + nodeid + '] tape mdp');
        for (var i = 0; i < pass.length; i++) {
          var cp = pass.charCodeAt(i);
          desktop.m.SendKeyUnicode(1, cp);
          await ml.sleep(15);
          desktop.m.SendKeyUnicode(2, cp);
          await ml.sleep(50);
        }
        await ml.sleep(200);

        ml.log('[' + nodeid + '] Enter');
        desktop.m.SendKeyMsgKC(1, 13);
        await ml.sleep(30);
        desktop.m.SendKeyMsgKC(2, 13);
        await ml.sleep(1000);

        try { desktop.Stop(); } catch (e) {}
        try { canvas.remove(); } catch (e) {}
        ml.log('[' + nodeid + '] termine');
        return true;
      };

      ml.runJobs = async function(jobs, login, pass) {
        if (ml.running) { ml.log('Worker deja en cours, ignore'); return; }
        ml.running = true;
        ml.total = jobs.length;
        ml.done = 0;
        ml.log('Lancement sur ' + jobs.length + ' poste(s)');
        for (var i = 0; i < jobs.length; i++) {
          await ml.loginOnNode(jobs[i], login, pass);
          ml.done = i + 1;
        }
        ml.log('--- termine ---');
        ml.running = false;
      };
    })();
  `;
  parent.document.body.appendChild(script);
}

async function runMultiLogin() {
  const login = document.getElementById('ml_user').value;
  const pass  = document.getElementById('ml_pass').value;
  if (!login || !pass) { alert('Login et mot de passe requis'); return; }

  // Selectionnes
  const allSelected = [...document.querySelectorAll('.ml_node_cb:checked')];
  if (allSelected.length === 0) { alert('Aucun poste coche'); return; }

  // Filtre : seulement les postes en ligne
  const online = allSelected.filter(i => i.hasAttribute('data-online'));
  const offline = allSelected.length - online.length;
  const nodes = online.map(i => i.value);

  if (nodes.length === 0) {
    alert(`Tous les postes coches (${offline}) sont hors ligne. Aucune connexion possible.`);
    return;
  }

  if (offline > 0) {
    const ok = confirm(`${offline} poste(s) hors ligne sera/seront ignore(s). Lancer sur les ${nodes.length} poste(s) en ligne ?`);
    if (!ok) return;
  }

  // Injection du worker dans parent (une seule fois)
  injectWorkerOnce();
  for (let i = 0; i < 20 && !parent.__multilogin; i++) {
    await new Promise(r => setTimeout(r, 50));
  }
  if (!parent.__multilogin) { alert('Worker non injecte'); return; }

  // Reset progression
  parent.__multilogin.done = 0;
  parent.__multilogin.total = nodes.length;
  try { localStorage.setItem('multilogin_log', ''); } catch (e) {}

  // Lance
  parent.__multilogin.runJobs(nodes, login, pass);

  // Polling progression + log
  const statusEl = document.getElementById('ml_status');
  const logEl = document.getElementById('ml_log');
  const poll = setInterval(() => {
    try {
      const ml = parent.__multilogin;
      if (!ml) { clearInterval(poll); return; }
      statusEl.textContent = ml.running
        ? `En cours : ${ml.done}/${ml.total}`
        : `Termine : ${ml.done}/${ml.total}`;
      if (logEl.style.display !== 'none') {
        logEl.textContent = localStorage.getItem('multilogin_log') || '';
        logEl.scrollTop = logEl.scrollHeight;
      }
      if (!ml.running) {
        clearInterval(poll);
        setTimeout(() => { if (!ml.running) statusEl.textContent += ' ✓'; }, 100);
      }
    } catch (e) { clearInterval(poll); }
  }, 500);
}

function toggleLogs() {
  const el = document.getElementById('ml_log');
  if (el.style.display === 'none') {
    el.style.display = 'block';
    el.textContent = localStorage.getItem('multilogin_log') || '(vide)';
    el.scrollTop = el.scrollHeight;
  } else {
    el.style.display = 'none';
  }
}

// ---- Gestion des comptes enregistres ----
function getAccounts() {
  try { return JSON.parse(localStorage.getItem('multilogin_accounts') || '[]'); }
  catch (e) { return []; }
}

function setAccounts(list) {
  try { localStorage.setItem('multilogin_accounts', JSON.stringify(list)); }
  catch (e) { alert('Erreur sauvegarde : ' + e.message); }
}

function refreshAccountsDropdown(selectName) {
  const sel = document.getElementById('ml_accounts');
  const accounts = getAccounts().sort((a, b) => a.name.localeCompare(b.name));
  sel.innerHTML = '<option value="">-- saisie manuelle --</option>';
  accounts.forEach(a => {
    const opt = document.createElement('option');
    opt.value = a.name;
    opt.textContent = a.name + ' (' + a.user + ')';
    sel.appendChild(opt);
  });
  if (selectName) sel.value = selectName;
}

function loadAccount() {
  const name = document.getElementById('ml_accounts').value;
  if (!name) return;
  const acc = getAccounts().find(a => a.name === name);
  if (!acc) return;
  document.getElementById('ml_user').value = acc.user;
  document.getElementById('ml_pass').value = acc.pass;
}

function saveAccount() {
  const user = document.getElementById('ml_user').value;
  const pass = document.getElementById('ml_pass').value;
  if (!user || !pass) { alert('Saisis d\'abord login et mot de passe'); return; }

  const name = prompt('Nom pour ce compte (par ex. "TEST", "maintenance prod") :', user);
  if (!name) return;

  const accounts = getAccounts();
  const existing = accounts.findIndex(a => a.name === name);
  const entry = { name, user, pass };
  if (existing >= 0) {
    if (!confirm('Un compte "' + name + '" existe deja. Remplacer ?')) return;
    accounts[existing] = entry;
  } else {
    accounts.push(entry);
  }
  setAccounts(accounts);
  refreshAccountsDropdown(name);
}

function deleteAccount() {
  const sel = document.getElementById('ml_accounts');
  const name = sel.value;
  if (!name) { alert('Selectionne d\'abord un compte a supprimer'); return; }
  if (!confirm('Supprimer le compte "' + name + '" ?')) return;
  setAccounts(getAccounts().filter(a => a.name !== name));
  refreshAccountsDropdown();
  document.getElementById('ml_user').value = '';
  document.getElementById('ml_pass').value = '';
}

// --- peuplement liste des postes ---

function selectAll(state) {
  document.querySelectorAll('.ml_node_cb').forEach(i => i.checked = state);
  document.querySelectorAll('.ml_group_cb').forEach(i => { i.checked = state; i.indeterminate = false; });
}

function selectWindowsOnly() {
  document.querySelectorAll('.ml_node_cb').forEach(i => {
    i.checked = i.hasAttribute('data-win');
  });
  // Resynchroniser l'etat des groupes
  document.querySelectorAll('.ml_group_cb').forEach(gcb => {
    const mid = gcb.dataset.meshid;
    const all = document.querySelectorAll(`.ml_node_cb[data-meshid="${CSS.escape(mid)}"]`);
    const allChecked = Array.from(all).every(cb => cb.checked);
    const someChecked = Array.from(all).some(cb => cb.checked);
    gcb.checked = allChecked;
    gcb.indeterminate = !allChecked && someChecked;
  });
}


// Au chargement de la page (y compris apres refresh de l'iframe), restaure le log
window.addEventListener('load', () => {
  try {
    const saved = localStorage.getItem('multilogin_log');
    if (saved) {
      const el = document.getElementById('ml_log');
      el.textContent = saved;
      el.scrollTop = el.scrollHeight;
    }
  } catch (e) {}
});

// Cherche l'objet nodes en remontant les iframes parentes
function findNodes() {
  const candidates = [];
  try { candidates.push(['parent.nodes', parent.nodes]); } catch (e) {}
  try { candidates.push(['parent.window.nodes', parent.window.nodes]); } catch (e) {}
  try { candidates.push(['top.nodes', top.nodes]); } catch (e) {}
  try { candidates.push(['top.window.nodes', top.window.nodes]); } catch (e) {}
  try { candidates.push(['parent.parent.nodes', parent.parent.nodes]); } catch (e) {}
  try { candidates.push(['parent.parent.window.nodes', parent.parent.window.nodes]); } catch (e) {}

  for (const [name, obj] of candidates) {
    if (obj && typeof obj === 'object' && Object.keys(obj).length > 0) {
      return { obj, source: name };
    }
  }
  return { obj: null, source: null, tried: candidates.map(c => c[0]) };
}

// Detection OS : agent.id 1-4 et 13 = Windows
const WINDOWS_AGENT_IDS = new Set([1, 2, 3, 4, 13]);

function osLabel(agentId) {
  if (WINDOWS_AGENT_IDS.has(agentId)) return 'Win';
  if ([5, 6, 14, 16, 19].includes(agentId)) return 'Linux';
  if ([11, 17].includes(agentId)) return 'Mac';
  return '?';
}

function findMeshes() {
  try { if (parent.meshes) return parent.meshes; } catch (e) {}
  try { if (top.meshes) return top.meshes; } catch (e) {}
  try { if (parent.parent.meshes) return parent.parent.meshes; } catch (e) {}
  return null;
}

const escapeHTML = (s) => String(s || '').replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));

function buildUI() {
  const nodesList = document.getElementById('ml_nodes_list');
  const groupsList = document.getElementById('ml_groups_list');
  nodesList.innerHTML = '';
  groupsList.innerHTML = '';

  const result = findNodes();
  if (!result.obj) {
    nodesList.innerHTML = '<div style="color:red">nodes introuvable. Essayes :<br>' + result.tried.join('<br>') + '</div>';
    return;
  }
  const nodesObj = result.obj;
  const meshesObj = findMeshes() || {};

  // Regroupe les nodes par meshid
  const nodesByMesh = {};
  let countWin = 0, countOther = 0;
  Object.values(nodesObj).forEach(n => {
    if (!n || !n._id) return;
    const mid = n.meshid || '__nogroup__';
    if (!nodesByMesh[mid]) nodesByMesh[mid] = [];
    nodesByMesh[mid].push(n);
    const isWin = WINDOWS_AGENT_IDS.has(n.agent ? n.agent.id : undefined);
    if (isWin) countWin++; else countOther++;
  });

  // Tri par nom de groupe
  const meshIds = Object.keys(nodesByMesh).sort((a, b) => {
    const na = (meshesObj[a] && meshesObj[a].name) || a;
    const nb = (meshesObj[b] && meshesObj[b].name) || b;
    return na.localeCompare(nb);
  });

  // ----- Panneau Groupes -----
  meshIds.forEach(mid => {
    const mesh = meshesObj[mid] || { name: '(sans groupe)' };
    const nodes = nodesByMesh[mid];
    const div = document.createElement('div');
    div.dataset.meshname = (mesh.name || mid).toLowerCase();
    div.innerHTML = `<label><input type="checkbox" class="ml_group_cb" data-meshid="${escapeHTML(mid)}"> ${escapeHTML(mesh.name)} <span style="color:#888;font-size:11px">(${nodes.length})</span></label>`;
    groupsList.appendChild(div);
  });

  // Tri postes par nom dans chaque groupe et affichage flat
  const allNodesSorted = [].concat(...meshIds.map(mid => nodesByMesh[mid].slice().sort((a, b) => (a.name || '').localeCompare(b.name || ''))));

  allNodesSorted.forEach(n => {
    const agentId = n.agent ? n.agent.id : undefined;
    const os = osLabel(agentId);
    const isWin = WINDOWS_AGENT_IDS.has(agentId);
    const online = (n.conn !== undefined) ? ((n.conn & 1) === 1) : false;
    const meshName = (meshesObj[n.meshid] && meshesObj[n.meshid].name) || '?';

    const div = document.createElement('div');
    div.dataset.nodename = (n.name || '').toLowerCase();
    div.dataset.meshid = n.meshid || '';
    const osTag = `<span style="color:${isWin ? '#080' : '#888'};font-size:11px;margin-left:6px">[${os}]</span>`;
    const onTag = online
      ? '<span style="color:#080;font-size:11px;margin-left:4px">●</span>'
      : '<span style="color:#c00;font-size:11px;margin-left:4px">○</span>';
    const meshTag = `<span style="color:#888;font-size:10px;margin-left:8px">${escapeHTML(meshName)}</span>`;
    div.innerHTML = `<label><input type="checkbox" class="ml_node_cb" value="${escapeHTML(n._id)}" data-meshid="${escapeHTML(n.meshid || '')}" ${isWin ? 'data-win="1"' : ''} ${online ? 'data-online="1"' : ''}> ${onTag} ${escapeHTML(n.name || n._id)} ${osTag} ${meshTag}</label>`;
    nodesList.appendChild(div);
  });

  document.getElementById('ml_count').textContent =
    `${countWin} Windows + ${countOther} autres dans ${meshIds.length} groupe(s)`;

  // Listener pour synchroniser groupes -> nodes
  document.querySelectorAll('.ml_group_cb').forEach(gcb => {
    gcb.addEventListener('change', () => {
      const mid = gcb.dataset.meshid;
      document.querySelectorAll(`.ml_node_cb[data-meshid="${CSS.escape(mid)}"]`).forEach(ncb => {
        ncb.checked = gcb.checked;
      });
    });
  });

  // Listener inverse : si tous les nodes d'un groupe sont coches, cocher le groupe
  document.querySelectorAll('.ml_node_cb').forEach(ncb => {
    ncb.addEventListener('change', () => {
      const mid = ncb.dataset.meshid;
      const groupCb = document.querySelector(`.ml_group_cb[data-meshid="${CSS.escape(mid)}"]`);
      if (!groupCb) return;
      const allInMesh = document.querySelectorAll(`.ml_node_cb[data-meshid="${CSS.escape(mid)}"]`);
      const allChecked = Array.from(allInMesh).every(cb => cb.checked);
      const someChecked = Array.from(allInMesh).some(cb => cb.checked);
      groupCb.checked = allChecked;
      groupCb.indeterminate = !allChecked && someChecked;
    });
  });
}

function filterGroups() {
  const q = document.getElementById('ml_search_groups').value.toLowerCase();
  document.querySelectorAll('#ml_groups_list div').forEach(d => {
    d.style.display = (!q || (d.dataset.meshname || '').includes(q)) ? '' : 'none';
  });
}

function filterNodes() {
  const q = document.getElementById('ml_search_nodes').value.toLowerCase();
  document.querySelectorAll('#ml_nodes_list div').forEach(d => {
    d.style.display = (!q || (d.dataset.nodename || '').includes(q)) ? '' : 'none';
  });
}

window.addEventListener('load', () => {
  buildUI();
  refreshAccountsDropdown();
});
</script>

</body>
</html>
