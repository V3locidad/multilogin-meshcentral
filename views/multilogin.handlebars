<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Multi-Login KVM</title>
<style>
  body { font-family: sans-serif; padding: 12px; }
  h2 { margin-top: 0; }
  .row { margin-bottom: 10px; }
  .row label { margin-right: 12px; }
  #ml_nodes { max-height: 320px; overflow: auto; border: 1px solid #ccc; padding: 8px; }
  #ml_nodes div { padding: 2px 0; }
  #ml_log { background: #111; color: #0f0; padding: 8px; height: 240px; overflow: auto; font-size: 12px; white-space: pre-wrap; }
  button { padding: 8px 16px; font-size: 14px; cursor: pointer; }
  .toolbar { margin: 10px 0; }
  input[type=text], input[type=password] { padding: 4px 6px; }
</style>
</head>
<body>

<h2>Connexion multiple (KVM)</h2>

<div class="row">
  <label>Login : <input id="ml_user" type="text" autocomplete="off"></label>
  <label>Mot de passe : <input id="ml_pass" type="password" autocomplete="new-password"></label>
</div>

<div class="toolbar">
  <button onclick="selectAll(true)">Tout cocher</button>
  <button onclick="selectWindowsOnly()">Cocher Windows uniquement</button>
  <button onclick="selectAll(false)">Tout decocher</button>
  <span id="ml_count" style="margin-left:10px;color:#666"></span>
</div>

<div id="ml_nodes">Chargement des postes...</div>

<div class="toolbar">
  <button onclick="runMultiLogin()">Lancer la connexion sur les postes coches</button>
</div>

<pre id="ml_log"></pre>

<script>
// ====================================================================
// Multi-Login KVM - protocole MeshCentral
// Format trame : [0x00, type, 0x00, size, ...payload]
// Types utiles : KEY=1, COMPRESSION=5, PAUSE=8, CAD=10, KEYUNICODE=85
// ====================================================================

const MAX_PARALLEL = 6;
const sleep = (ms) => new Promise(r => setTimeout(r, ms));
const bytes = (...arr) => new Uint8Array(arr);

// --- helpers protocole ---

// CAD : 4 octets, type 10
function sendCAD(ws) {
  ws.send(bytes(0x00, 10, 0x00, 0x04));
}

// KEYUNICODE : 7 octets, type 85. action 1=down -> 0, action 2=up -> 1
function sendUnicode(ws, action, codepoint) {
  ws.send(bytes(
    0x00, 85, 0x00, 0x07,
    action - 1,
    (codepoint >> 8) & 0xFF,
    codepoint & 0xFF
  ));
}

// KEY (scancode XT) : 6 octets, type 1. action 0=down, 1=up
function sendKey(ws, action, kc) {
  ws.send(bytes(0x00, 1, 0x00, 0x06, action, kc));
}

// Init standard : compression + unpause
function sendInit(ws) {
  // type=1 (JPEG), level=50, scaling=1024 (0x0400), fps=100 (0x0064)
  ws.send(bytes(0x00, 5, 0x00, 0x0A, 1, 50, 0x04, 0x00, 0x00, 0x64));
  // Unpause
  ws.send(bytes(0x00, 8, 0x00, 0x05, 0x00));
}

// Scancodes XT minimaux
const SC_TAB = 0x0F;
const SC_ENTER = 0x1C;

async function typeText(ws, s, delayMs = 40) {
  for (const ch of s) {
    const cp = ch.charCodeAt(0);
    sendUnicode(ws, 1, cp);
    sendUnicode(ws, 2, cp);
    await sleep(delayMs);
  }
}

async function tapKey(ws, scancode) {
  sendKey(ws, 0, scancode);
  await sleep(30);
  sendKey(ws, 1, scancode);
}

// --- logique principale ---

// Cherche meshserver dans les iframes parentes
function findMeshserver() {
  const tries = [];
  try { tries.push(parent.meshserver); } catch (e) {}
  try { tries.push(parent.parent.meshserver); } catch (e) {}
  try { tries.push(top.meshserver); } catch (e) {}
  for (const ms of tries) { if (ms && typeof ms.send === 'function') return ms; }
  return null;
}

// Genere un id de tunnel aleatoire (compatible MeshCentral)
function makeTunnelId() {
  const arr = new Uint8Array(8);
  crypto.getRandomValues(arr);
  return Array.from(arr).map(b => b.toString(16).padStart(2, '0')).join('');
}

async function loginOnNode(nodeid, login, pass, log) {
  return new Promise((resolve) => {
    const ms = findMeshserver();
    if (!ms) {
      log(`[${nodeid}] ERREUR : meshserver introuvable dans parent.*`);
      return resolve(false);
    }

    const tunnelId = makeTunnelId();
    const proto = location.protocol === 'https:' ? 'wss:' : 'ws:';
    const browserUrl = `${proto}//${location.host}/meshrelay.ashx?browser=1&p=2&nodeid=${encodeURIComponent(nodeid)}&id=${tunnelId}`;
    const agentUrl = `*/meshrelay.ashx?p=2&nodeid=${encodeURIComponent(nodeid)}&id=${tunnelId}`;

    // 1. Demande au serveur d'instruire l'agent d'ouvrir son cote du tunnel
    try {
      ms.send({ action: 'msg', type: 'tunnel', nodeid: nodeid, value: agentUrl, usage: 2 });
    } catch (e) {
      log(`[${nodeid}] ms.send erreur : ${e.message}`);
      return resolve(false);
    }

    // 2. Ouvre le cote navigateur
    let ws;
    try { ws = new WebSocket(browserUrl); }
    catch (e) { log(`[${nodeid}] WS exception : ${e}`); return resolve(false); }
    ws.binaryType = 'arraybuffer';

    let firstMsgReceived = false;
    const timer = setTimeout(() => {
      log(`[${nodeid}] timeout 20s (firstMsg=${firstMsgReceived})`);
      try { ws.close(); } catch (e) {}
      resolve(false);
    }, 20000);

    ws.onmessage = (e) => {
      const len = e.data.byteLength !== undefined ? e.data.byteLength : (e.data.length || 0);
      if (!firstMsgReceived) {
        firstMsgReceived = true;
        log(`[${nodeid}] 1er msg recu (${len} octets) -> agent connecte`);
      }
    };

    ws.onopen = async () => {
      log(`[${nodeid}] WS ouvert, attente connexion agent...`);
      // Attendre que l'agent ait connecte son cote (premier message recu, ou 3s max)
      const waitStart = Date.now();
      while (!firstMsgReceived && (Date.now() - waitStart) < 3000) { await sleep(100); }
      if (!firstMsgReceived) log(`[${nodeid}] aucun message agent apres 3s, on tente quand meme`);

      sendInit(ws);
      await sleep(500);

      sendCAD(ws);
      await sleep(2500);

      await typeText(ws, login);
      await sleep(150);
      await tapKey(ws, SC_TAB);
      await sleep(200);
      await typeText(ws, pass);
      await sleep(200);
      await tapKey(ws, SC_ENTER);
      await sleep(1500);

      clearTimeout(timer);
      try { ws.close(); } catch (e) {}
      log(`[${nodeid}] sequence envoyee`);
      resolve(true);
    };

    ws.onerror = () => log(`[${nodeid}] WS erreur`);
    ws.onclose = (ev) => log(`[${nodeid}] close code=${ev.code}${ev.reason ? ' reason='+ev.reason : ''}`);
  });
}

async function runMultiLogin() {
  const login = document.getElementById('ml_user').value;
  const pass  = document.getElementById('ml_pass').value;
  if (!login || !pass) { alert('Login et mot de passe requis'); return; }

  const nodes = [...document.querySelectorAll('#ml_nodes input[type=checkbox]:checked')]
                  .map(i => i.value);
  if (nodes.length === 0) { alert('Aucun poste coche'); return; }

  const logEl = document.getElementById('ml_log');
  const log = (m) => {
    logEl.textContent += m + '\n';
    logEl.scrollTop = logEl.scrollHeight;
  };

  log(`Lancement sur ${nodes.length} poste(s), ${MAX_PARALLEL} en parallele`);

  let i = 0;
  async function worker() {
    while (i < nodes.length) {
      const id = nodes[i++];
      await loginOnNode(id, login, pass, log);
    }
  }
  await Promise.all(Array(Math.min(MAX_PARALLEL, nodes.length)).fill(0).map(worker));
  log('--- termine ---');
}

// --- peuplement liste des postes ---

function selectAll(state) {
  document.querySelectorAll('#ml_nodes input[type=checkbox]').forEach(i => i.checked = state);
}

function selectWindowsOnly() {
  document.querySelectorAll('#ml_nodes input[type=checkbox]').forEach(i => {
    i.checked = i.hasAttribute('data-win');
  });
}

// Cherche l'objet nodes en remontant les iframes parentes
function findNodes() {
  const candidates = [];
  try { candidates.push(['parent.nodes', parent.nodes]); } catch (e) {}
  try { candidates.push(['parent.window.nodes', parent.window.nodes]); } catch (e) {}
  try { candidates.push(['top.nodes', top.nodes]); } catch (e) {}
  try { candidates.push(['top.window.nodes', top.window.nodes]); } catch (e) {}
  try { candidates.push(['parent.parent.nodes', parent.parent.nodes]); } catch (e) {}
  try { candidates.push(['parent.parent.window.nodes', parent.parent.window.nodes]); } catch (e) {}

  for (const [name, obj] of candidates) {
    if (obj && typeof obj === 'object' && Object.keys(obj).length > 0) {
      return { obj, source: name };
    }
  }
  return { obj: null, source: null, tried: candidates.map(c => c[0]) };
}

// Detection OS : agent.id 1-4 et 13 = Windows
const WINDOWS_AGENT_IDS = new Set([1, 2, 3, 4, 13]);

function osLabel(agentId) {
  if (WINDOWS_AGENT_IDS.has(agentId)) return 'Win';
  if ([5, 6, 14, 16, 19].includes(agentId)) return 'Linux';
  if ([11, 17].includes(agentId)) return 'Mac';
  return '?';
}

window.addEventListener('load', () => {
  const container = document.getElementById('ml_nodes');
  container.innerHTML = '';

  const result = findNodes();
  if (!result.obj) {
    container.innerHTML = '<div style="color:red">Impossible de trouver l\'objet nodes. Chemins essayes :<br>'
      + result.tried.join('<br>') + '</div>';
    return;
  }

  const nodesObj = result.obj;
  let countWin = 0, countOther = 0;

  Object.values(nodesObj).forEach(n => {
    if (!n || !n._id) return;
    const agentId = n.agent ? n.agent.id : undefined;
    const os = osLabel(agentId);
    const isWin = WINDOWS_AGENT_IDS.has(agentId);
    if (isWin) countWin++; else countOther++;

    const div = document.createElement('div');
    const safeName = (n.name || n._id).replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));
    const tag = `<span style="color:${isWin ? '#080' : '#888'};font-size:11px;margin-left:6px">[${os}]</span>`;
    div.innerHTML = `<label><input type="checkbox" value="${n._id}" ${isWin ? 'data-win="1"' : ''}> ${safeName} ${tag}</label>`;
    container.appendChild(div);
  });

  document.getElementById('ml_count').textContent =
    `${countWin} Windows + ${countOther} autres (source : ${result.source})`;

  if (countWin + countOther === 0) {
    container.textContent = 'Objet nodes trouve mais vide';
  }
});
</script>

</body>
</html>
